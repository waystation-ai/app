{
  "openapi": "3.1.0",
  "info": {
    "title": "Waystation Monday Boards API",
    "description": "API to retrieve a list of a user's boards from Monday.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://waystation.ai",
      "description": "Waystation Beta Server"
    }
  ],
  "paths": {
    "/tools/monday/list_boards": {
      "get": {
        "operationId": "listMondayBoards",
        "summary": "Get a list of user's boards from Monday",
        "description": "Retrieves a list of boards associated with the authenticated user from Monday.",
        "responses": {
          "200": {
            "description": "A JSON array of user boards.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the board."
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the board."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication is required."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        }
      }
    }
  }
}
