{
  "openapi": "3.1.0",
  "info": {
    "title": "Waystation API",
    "description": "A set of tools that connect ChatGPT to productivity apps",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://waystation.ai",
      "description": "Waystation Server"
    }
  ],
  "paths": {
    "/tools/slack/post_message": {
      "post": {
        "operationId": "postSlackMessage",
        "summary": "Post a message to a Slack channel",
        "description": "Posts a plain text message to a specified Slack channel that the authenticated user has access to.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["channel", "message"],
                "properties": {
                  "channel": {
                    "type": "string",
                    "description": "Channel name with or without # prefix (e.g., 'general' or '#general')"
                  },
                  "message": {
                    "type": "string",
                    "description": "Plain text message to post"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message posted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ts": {
                      "type": "string",
                      "description": "Timestamp of the message"
                    },
                    "channel": {
                      "type": "string",
                      "description": "Channel the message was posted to"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid channel name or message"
          },
          "401": {
            "description": "Unauthorized - Authentication is required"
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server"
          }
        }
      }
    },
    "/tools/slack/list_channels": {
      "get": {
        "operationId": "listSlackChannels",
        "summary": "Get a list of user's Slack channels",
        "description": "Retrieves a list of Slack channels that the authenticated user has access to.",
        "responses": {
          "200": {
            "description": "A JSON array of channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the channel"
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the channel"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type of channel (public or private)",
                        "enum": ["public", "private"]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication is required."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        }
      }
    }
  }
}
