{
  "openapi": "3.1.0",
  "info": {
    "title": "Waystation API",
    "description": "A set of tools that connect ChatGPT to productivity apps",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://waystation.ai",
      "description": "Waystation Server"
    }
  ],
  "paths": {
    "/tools/monday/list_boards": {
      "get": {
        "operationId": "listMondayBoards",
        "summary": "Get a list of user's boards from Monday",
        "description": "Retrieves a list of boards associated with the authenticated user from Monday.",
        "responses": {
          "200": {
            "description": "A JSON array of user boards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the board"
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the board"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication is required."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        }
      }
    },
    "/tools/monday/read_board": {
      "get": {
        "operationId": "readMondayBoard",
        "summary": "Get items from a specific Monday board",
        "description": "Retrieves all items from the specified Monday board. The items can be arbitrary JSON objects.",
        "parameters": [
          {
            "name": "boardId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the Monday board."
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of board items.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "Arbitrary JSON object representing a board item."
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid or missing board ID."
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        }
      }
    },
    "/tools/monday/new_item": {
      "post": {
        "operationId": "createMondayItem",
        "summary": "Create a new item in a Monday board",
        "description": "Creates a new item in the specified Monday board and group with optional column values.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "board_id",
                  "group_id",
                  "item_name"
                ],
                "properties": {
                  "board_id": {
                    "type": "string",
                    "description": "The unique identifier of the Monday board"
                  },
                  "group_id": {
                    "type": "string",
                    "description": "The unique identifier of the group within the board"
                  },
                  "item_name": {
                    "type": "string",
                    "description": "Name of the new item to create"
                  },
                  "column_values": {
                    "type": "object",
                    "description": "Optional object containing column values for the new item",
                    "properties": {},
                    "additionalProperties": true,
                    "example": {
                      "status": "Planning",
                      "person": "1324234"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier of the created item"
                    },
                    "url": {
                      "type": "string",
                      "description": "URL to access the item in Monday.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters"
          },
          "401": {
            "description": "Unauthorized - Authentication is required"
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server"
          }
        }
      }
    },
    "/tools/monday/update_item": {
      "post": {
        "operationId": "updateMondayItem",
        "summary": "Update an existing item in a Monday board",
        "description": "Updates an existing item in the specified Monday board with new column values. The `column_values` parameter is **required** and should always include the updated field(s) in `{ \"column_id\": \"new_value\" }` format.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "board_id",
                  "item_id",
                  "column_values"
                ],
                "properties": {
                  "board_id": {
                    "type": "string",
                    "description": "The unique identifier of the Monday board"
                  },
                  "item_id": {
                    "type": "string",
                    "description": "The unique identifier of the item to update"
                  },
                  "column_values": {
                    "type": "object",
                    "description": "Object containing column values to update for the item",
                    "properties": {},
                    "additionalProperties": true,
                    "example": {
                      "status": "Planning",
                      "person": "1324234"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier of the updated item"
                    },
                    "url": {
                      "type": "string",
                      "description": "URL to access the item in Monday.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters"
          },
          "401": {
            "description": "Unauthorized - Authentication is required"
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server"
          }
        }
      }
    },
    "/tools/monday/create_update": {
      "post": {
        "operationId": "createMondayUpdate",
        "summary": "Create a new update on a Monday.com item",
        "description": "Creates a new update (comment) on the specified Monday.com item with optional parent_id for threaded replies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "item_id",
                  "body"
                ],
                "properties": {
                  "item_id": {
                    "type": "string",
                    "description": "The unique identifier of the item to add the update to"
                  },
                  "body": {
                    "type": "string",
                    "description": "The text content of the update"
                  },
                  "parent_id": {
                    "type": "string",
                    "description": "Optional ID of the parent update for threaded replies"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created update",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier of the created update"
                    },
                    "body": {
                      "type": "string",
                      "description": "Text content of the update"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Timestamp when the update was created"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters"
          },
          "401": {
            "description": "Unauthorized - Authentication is required"
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server"
          }
        }
      }
    },
    "/tools/slack/post_message": {
      "post": {
        "operationId": "postSlackMessage",
        "summary": "Post a message to a Slack channel",
        "description": "Posts a plain text message to a specified Slack channel that the authenticated user has access to.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel",
                  "message"
                ],
                "properties": {
                  "channel": {
                    "type": "string",
                    "description": "Channel name with or without # prefix (e.g., 'general' or '#general')"
                  },
                  "message": {
                    "type": "string",
                    "description": "Plain text message to post"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message posted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ts": {
                      "type": "string",
                      "description": "Timestamp of the message"
                    },
                    "channel": {
                      "type": "string",
                      "description": "Channel the message was posted to"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid channel name or message"
          },
          "401": {
            "description": "Unauthorized - Authentication is required"
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server"
          }
        }
      }
    },
    "/tools/slack/list_channels": {
      "get": {
        "operationId": "listSlackChannels",
        "summary": "Get a list of user's Slack channels",
        "description": "Retrieves a list of Slack channels that the authenticated user has access to.",
        "responses": {
          "200": {
            "description": "A JSON array of channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the channel"
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the channel"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type of channel (public or private)",
                        "enum": [
                          "public",
                          "private"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication is required."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        }
      }
    },
    "/tools/gdrive/list_google_docs": {
      "get": {
        "operationId": "listGoogleDocs",
        "summary": "List all Google Docs in your Drive",
        "description": "Retrieves a list of Google Docs associated with the authenticated user's Drive.",
        "responses": {
          "200": {
            "description": "A JSON array of Google Docs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for the Google Doc"
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the Google Doc"
                      },
                      "url": {
                        "type": "string",
                        "description": "URL to access the Google Doc"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication is required."
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server."
          }
        }
      }
    },
    "/tools/gdrive/read_google_doc": {
      "get": {
        "operationId": "readGoogleDoc",
        "summary": "Read the content of a specific Google Doc",
        "description": "Retrieves the content of a specified Google Doc that the authenticated user has access to.",
        "parameters": [
          {
            "name": "docId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the Google Doc to read"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved Google Doc content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string",
                      "description": "The text content of the Google Doc"
                    },
                    "title": {
                      "type": "string",
                      "description": "The title of the Google Doc"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid or missing document ID"
          },
          "401": {
            "description": "Unauthorized - Authentication is required"
          },
          "404": {
            "description": "Not Found - Document not found or inaccessible"
          },
          "500": {
            "description": "Internal Server Error - Something went wrong on the server"
          }
        }
      }
    }
  }
}